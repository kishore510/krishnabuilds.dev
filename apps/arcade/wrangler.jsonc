{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krishnabuilds-arcade",
  "compatibility_date": "2026-07-07",
  "main": "src/worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Deploys run from GitHub Actions in the krishnabuilds.dev monorepo
  // (.github/workflows/deploy-arcade.yml) on pushes to main.
  "kv_namespaces": [
    {
      "binding": "PLAY_COUNTS",
      "id": "00630bb9801840ee82a86724e49bd044"
    }
  ],
  "routes": [{ "pattern": "arcade.krishnabuilds.dev", "custom_domain": true }]
}
