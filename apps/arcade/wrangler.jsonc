{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krishnabuilds-arcade",
  "compatibility_date": "2026-07-07",
  "main": "src/worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Deploys run from GitHub Actions in the krishnabuilds.dev monorepo
  // (.github/workflows/deploy-arcade.yml) on pushes to main.
  "kv_namespaces": [
    {
      "binding": "PLAY_COUNTS",
      "id": "00630bb9801840ee82a86724e49bd044"
    }
  ],
  // Basic per-IP limit on POST /api/play/<slug>. namespace_id is a
  // free-form number unique within the account, not a secret.
  "ratelimits": [
    {
      "name": "PLAY_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    // Wildcard: new online tables per IP (POST /api/wildcard/rooms). A
    // per-day limit comes in a later slice; this stops bursts.
    {
      "name": "ROOM_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  // Wildcard online tables: one Durable Object per room code (src/wildcard-table.js).
  "durable_objects": {
    "bindings": [{ "name": "WILDCARD_TABLE", "class_name": "WildcardTable" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WildcardTable"] }],
  "routes": [{ "pattern": "arcade.krishnabuilds.dev", "custom_domain": true }]
}
