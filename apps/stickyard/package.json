{
  "name": "stickyard",
  "version": "0.44.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p dev/load",
    "test": "vitest run --config dev/load/vitest.unit.config.ts",
    "dev:web": "pnpm --filter @stickyard/web dev",
    "dev:worker": "pnpm --filter @stickyard/worker dev",
    "shots": "node scripts/shots.mjs",
    "load": "vitest run --config dev/load/vitest.load.config.ts",
    "a11y": "node dev/a11y/audit.mjs"
  },
  "devDependencies": {
    "@stickyard/shared": "workspace:*",
    "@types/node": "24.19.1",
    "axe-core": "4.10.3",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  }
}
