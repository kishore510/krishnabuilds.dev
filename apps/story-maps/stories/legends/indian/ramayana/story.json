  "steps": [
    {
      "place": "ayodhya",
      "phase": "prelude",
      "title": "A curse by the Sarayu",
      "native": "सरयू",
      "when": "Before Rama’s birth",
      "at": 3,
      "camera": {
        "at": [
          82.2,
          26.4
        ],
        "width": 13
      },
      "legs": [],
      "text": "Long before his sons are born, young Dasharatha hunts by the Sarayu at night. Hearing a sound like an elephant drinking, he shoots, and kills Shravana Kumara, who was fetching water for his blind parents. Dying of grief, they curse the king to die mourning a son. The curse comes true years later.",
      "today": "Traditionally on the banks of the Sarayu near Ayodhya."
    },
    {
      "place": "ayodhya",
      "phase": "prelude",
      "title": "Four sons",
      "native": "अयोध्या",
      "when": "Rama is born",
      "at": 9,
      "camera": {
        "at": [
          82.2,
          26.4
        ],
        "width": 13
      },
      "legs": [],
      "text": "Childless, Dasharatha holds a great fire ritual (yajna). The sacred offering is shared among his queens, and four sons are born: Rama to Kaushalya, Bharata to Kaikeyi, and the twins Lakshmana and Shatrughna to Sumitra. In the tradition, the gods had begged Vishnu to be born as a man to end Ravana’s tyranny.",
      "today": "Today: Ayodhya, Uttar Pradesh."
    },
    {
      "place": "buxar",
      "phase": "prelude",
      "title": "Guarding the yajna",
      "native": "सिद्धाश्रम",
      "when": "Rama, about 15",
      "at": 17,
      "camera": {
        "at": [
          83.2,
          26.2
        ],
        "width": 11
      },
      "legs": [
        {
          "from": "ayodhya",
          "to": "buxar",
          "traveller": "rama",
          "style": "walk",
          "bend": 0.12
        }
      ],
      "text": "Sage Vishwamitra asks Dasharatha to lend him the boy Rama, with Lakshmana, to guard his fire ritual (yajna). On the way they kill the demoness Tataka and receive divine weapons. At the hermitage Rama kills Subahu and drives off Maricha, who had been defiling the rites.",
      "today": "Traditionally Siddhashrama, today Buxar, Bihar."
    },
    {
      "place": "mithila",
      "phase": "prelude",
      "title": "The bow of Shiva",
      "native": "मिथिला",
      "when": "Rama, about 16",
      "at": 23,
      "camera": {
        "at": [
          84.6,
          26.2
        ],
        "width": 11.5
      },
      "legs": [
        {
          "from": "buxar",
          "to": "mithila",
          "traveller": "rama",
          "style": "walk",
          "bend": -0.14
        }
      ],
      "text": "Vishwamitra leads them on to Mithila. On the way, Rama’s arrival frees Ahalya from her long curse. King Janaka has promised his daughter Sita to whoever can string Shiva’s great bow. Rama lifts it and it breaks. Rama marries Sita, and his three brothers marry Sita’s sister Urmila and her two cousins on the same day.",
      "today": "Traditionally Janakpur in Nepal. Sitamarhi in Bihar also claims Sita’s birthplace."
    },
    {
      "place": "ayodhya",
      "phase": "palace",
      "title": "The night before the crown",
      "native": "अयोध्या",
      "when": "Rama, about 25",
      "at": 29,
      "camera": {
        "at": [
          83,
          25.5
        ],
        "width": 15
      },
      "legs": [
        {
          "from": "mithila",
          "to": "ayodhya",
          "traveller": "rama",
          "style": "walk",
          "bend": 0.12
        }
      ],
      "text": "The brothers return to Ayodhya with their brides, and years of happiness follow. Then Rama is to be crowned. Queen Kaikeyi calls in two old boons from King Dasharatha: her son Bharata is to be king, and Rama must spend fourteen years in the forest. Rama accepts without protest. With Sita and Lakshmana, he leaves the city.",
      "today": "Today: Ayodhya, Uttar Pradesh."
    },
    {
      "place": "sring",
      "phase": "exile",
      "title": "The crossing of the Ganga",
      "native": "शृंगवेरपुर",
      "when": "Exile, day 1",
      "at": 33,
      "camera": {
        "at": [
          81.5,
          25.5
        ],
        "width": 10
      },
      "legs": [
        {
          "from": "ayodhya",
          "to": "sring",
          "traveller": "rama",
          "style": "walk",
          "bend": 0.14
        }
      ],
      "text": "On the bank of the Ganga the exiles meet Guha, king of the boatmen. He ferries them across and offers his own kingdom as shelter. Rama sets aside his royal clothes and ties his hair in the matted locks of an ascetic.",
      "today": "Traditionally Sringaverapura, today Singraur near Prayagraj, Uttar Pradesh."
    },
    {
      "place": "chitra",
      "phase": "exile",
      "title": "A hut among the hills",
      "native": "चित्रकूट",
      "when": "Exile, first weeks",
      "at": 37,
      "camera": {
        "at": [
          80.5,
          24.6
        ],
        "width": 10
      },
      "legs": [
        {
          "from": "sring",
          "to": "chitra",
          "traveller": "rama",
          "style": "walk",
          "bend": -0.18
        }
      ],
      "text": "The three settle at Chitrakoot. Bharata arrives with the whole court to bring Rama home. Rama keeps his father’s word and refuses. Bharata takes Rama’s sandals back to Ayodhya and rules in their name, waiting out the fourteen years.",
      "today": "Today: Chitrakoot, on the Uttar Pradesh and Madhya Pradesh border."
    },
    {
      "place": "dandaka",
      "phase": "exile",
      "title": "Into the great forest",
      "native": "दण्डकारण्य",
      "when": "Exile, years 1 to 10",
      "at": 44,
      "camera": {
        "at": [
          79.5,
          22
        ],
        "width": 18
      },
      "legs": [
        {
          "from": "chitra",
          "to": "dandaka",
          "traveller": "rama",
          "style": "walk",
          "bend": 0.14
        }
      ],
      "text": "Years pass in the Dandaka forest, moving from one sage’s hermitage to the next. Rama promises the sages protection from the demons who wreck their rites. He and Lakshmana fight them off, and the forest grows more dangerous.",
      "today": "Traditionally a forest belt across Chhattisgarh, Odisha and Maharashtra."
    },
    {
      "place": "panchavati",
      "phase": "taken",
      "title": "The golden deer",
      "native": "पंचवटी",
      "when": "Exile, years 10 to 13",
      "at": 62,
      "camera": {
        "at": [
          76,
          16
        ],
        "width": 28.5
      },
      "legs": [
        {
          "from": "dandaka",
          "to": "panchavati",
          "traveller": "rama",
          "style": "walk",
          "bend": -0.12
        },
        {
          "from": "panchavati",
          "to": "lanka",
          "traveller": "ravana",
          "style": "ravana",
          "bend": 0.18
        }
      ],
      "text": "At Panchavati, beside the Godavari, they build a home. Surpanakha’s humiliation brings Ravana’s attention. A golden deer, the demon Maricha in disguise, lures Rama away, and Lakshmana follows. Ravana seizes Sita and carries her through the sky to Lanka.",
      "today": "Today: Panchavati, Nashik, Maharashtra."
    },
    {
      "place": "lepakshi",
      "phase": "taken",
      "title": "The fall of Jatayu",
      "native": "लेपाक्षी",
      "when": "Exile, year 13",
      "at": 72,
      "camera": {
        "at": [
          76,
          16
        ],
        "width": 18
      },
      "legs": [
        {
          "from": "panchavati",
          "to": "lepakshi",
          "traveller": "rama",
          "style": "walk",
          "bend": 0.1
        }
      ],
      "text": "Rama and Lakshmana return to an empty hut and search south. They find the vulture Jatayu, mortally wounded after trying to stop Ravana. With his last breath he tells them which way Ravana flew. Rama performs his funeral rites.",
      "today": "Tradition places this at Lepakshi, Andhra Pradesh."
    },
    {
      "place": "kishkindha",
      "phase": "search",
      "title": "Hanuman and the vanara king",
      "native": "किष्किन्धा",
      "when": "Exile, final year",
      "at": 77,
      "camera": {
        "at": [
          76.8,
          14.6
        ],
        "width": 15
      },
      "legs": [
        {
          "from": "lepakshi",
          "to": "kishkindha",
          "traveller": "rama",
          "style": "walk",
          "bend": 0.1
        }
      ],
      "text": "Near Lake Pampa the old ascetic Shabari offers Rama berries, and Hanuman, minister of the exiled Sugriva, meets the brothers. Rama and Sugriva pledge friendship. Rama defeats Vali, Sugriva takes the throne, and the vanaras scatter in every direction to find Sita.",
      "today": "Today: the Hampi and Anegundi area, Karnataka."
    },
    {
      "place": "mahendra",
      "phase": "search",
      "title": "The southern search party",
      "native": "महेन्द्रगिरि",
      "when": "Exile, final year",
      "at": 83,
      "camera": {
        "at": [
          77,
          11.5
        ],
        "width": 17
      },
      "legs": [
        {
          "from": "kishkindha",
          "to": "mahendra",
          "traveller": "hanuman",
          "style": "search",
          "bend": -0.1
        }
      ],
      "text": "The southern party under Angada and Hanuman reaches the sea. Sampati, Jatayu’s brother, can see Lanka a hundred yojanas across the water. Jambavan reminds Hanuman of the strength he has forgotten, and the mountain shakes as Hanuman prepares to leap.",
      "today": "Traditionally the Mahendragiri hills of the far south."
    },
    {
      "place": "lanka",
      "phase": "search",
      "title": "Hanuman crosses the sea",
      "native": "लंका",
      "when": "Exile, final year",
      "at": 88,
      "camera": {
        "at": [
          79,
          9
        ],
        "width": 15
      },
      "legs": [
        {
          "from": "mahendra",
          "to": "lanka",
          "traveller": "hanuman",
          "style": "leap",
          "bend": 0.3
        }
      ],
      "text": "Hanuman leaps across the ocean, past Surasa and Simhika, and lands in Lanka. In the Ashoka grove he finds Sita and gives her Rama’s ring. Captured, he lets Ravana’s guards set his tail alight, and burns much of the city before returning.",
      "today": "Traditionally Sri Lanka, identified with Ravana’s Lanka."
    },
    {
      "place": "rameswaram",
      "phase": "war",
      "title": "A bridge across the sea",
      "native": "रामेश्वरम्",
      "when": "Exile, final year",
      "at": 92,
      "camera": {
        "at": [
          77.6,
          11.8
        ],
        "width": 18
      },
      "legs": [
        {
          "from": "kishkindha",
          "to": "rameswaram",
          "traveller": "rama",
          "style": "march",
          "bend": 0.1
        }
      ],
      "text": "Rama marches south with the vanara army to the shore at Rameswaram. Ravana’s brother Vibhishana, who had urged Ravana to return Sita, joins Rama. Nala directs the army as they lay stones on the water, and the Setu begins to rise toward Lanka.",
      "today": "Today: Rameswaram, Tamil Nadu. The shoals are known as Ram Setu or Adam’s Bridge."
    },
    {
      "place": "lanka",
      "phase": "war",
      "title": "The war for Lanka",
      "native": "लंका",
      "when": "Exile, final months",
      "at": 96,
      "camera": {
        "at": [
          80,
          8.5
        ],
        "width": 11.5
      },
      "legs": [
        {
          "from": "rameswaram",
          "to": "setu-landing",
          "traveller": "rama",
          "style": "bridge",
          "bend": 0
        },
        {
          "from": "setu-landing",
          "to": "lanka",
          "traveller": "rama",
          "style": "march",
          "bend": 0.05
        }
      ],
      "text": "The armies cross the Setu and meet before the golden city. Kumbhakarna and Indrajit fall. At last Rama faces Ravana and ends him, a victory remembered each year at Dussehra. Vibhishana is crowned king of Lanka, and Sita is free.",
      "today": "Traditionally the highlands and coast of Sri Lanka."
    },
    {
      "place": "ayodhya",
      "phase": "home",
      "title": "The return",
      "native": "अयोध्या",
      "when": "Exile ends, year 14",
      "at": 99,
      "camera": {
        "at": [
          81,
          17
        ],
        "width": 21.5
      },
      "legs": [
        {
          "from": "lanka",
          "to": "ayodhya",
          "traveller": "pushpaka",
          "style": "fly",
          "bend": 0.12
        }
      ],
      "text": "The fourteen years are over. Rama, Sita and Lakshmana fly home in the Pushpaka Vimana. Ayodhya lights rows of lamps to welcome them, remembered as the origin of Diwali. Bharata returns the sandals, and Rama is crowned.",
      "today": "Today: Ayodhya, where the story began."
    }
  ],
