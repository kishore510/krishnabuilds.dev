  "people": {
    "heading": "People in this chapter",
    "items": [
      {
        "id": "bindusara",
        "name": "Bindusara",
        "native": "बिन्दुसार",
        "life": "r. c. 297 to 273 BCE",
        "role": "Ashoka’s father, the second Maurya emperor",
        "steps": [
          0,
          1,
          4
        ],
        "text": "The second Maurya emperor, son of Chandragupta. Greek writers call him Amitrochates, from the Sanskrit for ‘slayer of foes’, and tell how he asked the Seleucid king Antiochus to send him sweet wine, dried figs and a philosopher. Buddhist texts say he followed the Ajivika ascetics and did not want Ashoka as his heir."
      },
      {
        "id": "devi",
        "name": "Devi",
        "native": "देवी",
        "life": "Not known",
        "role": "Ashoka’s first wife, by the chronicles",
        "steps": [
          3
        ],
        "text": "A merchant’s daughter of Vidisha, known only from the Sri Lankan chronicles, which call her Devi or Vedisa-Mahadevi. She married Ashoka while he governed Avanti and bore Mahinda and Sanghamitta, but stayed at Vidisha when he became king. The chronicles say Mahinda visited her there, at a monastery she had built, before leaving for Sri Lanka."
      },
      {
        "id": "mahinda",
        "name": "Mahinda",
        "native": "महिन्द (lang pi)",
        "life": "3rd century BCE",
        "role": "Monk, Ashoka’s son",
        "steps": [
          3,
          12
        ],
        "text": "Ashoka’s son, by the Sri Lankan account, who became a monk at about twenty and led the mission to Sri Lanka. There he converted King Devanampiya Tissa, and the Mahavihara, the great monastery of Anuradhapura, was founded. He is said to have stayed for the rest of his life. The Chinese pilgrim Xuanzang calls him Ashoka’s brother instead."
      },
      {
        "id": "sanghamitta",
        "name": "Sanghamitta",
        "native": "सङ्घमित्ता (lang pi)",
        "life": "3rd century BCE",
        "role": "Nun, Ashoka’s daughter",
        "steps": [
          3,
          12
        ],
        "text": "Ashoka’s daughter, by the Sri Lankan chronicles, a nun who brought a branch of the Bodhi tree from Bodh Gaya to Anuradhapura and there founded an order of nuns. Sri Lankan Buddhists remember her on the full moon of Unduvap, in December, which is kept as Sanghamitta Day."
      },
      {
        "id": "prinsep",
        "name": "James Prinsep",
        "life": "1799 to 1840",
        "role": "Scholar who read the edicts",
        "steps": [
          15
        ],
        "text": "An English scholar and assay master of the Calcutta Mint who ran the Asiatic Society’s journal. Working from short donors’ inscriptions at Sanchi, he cracked the Brahmi script in 1837 and soon read edicts on pillars and rocks across India. Their author, Devanampiya Piyadasi, was linked to the Ashoka of the chronicles at about the same time."
      }
    ]
