  "people": {
    "heading": "People",
    "items": [
      {
        "id": "babur",
        "name": "Babur",
        "native": "ظهیرالدین محمد بابر",
        "lang": "fa",
        "life": "1483–1530",
        "role": "Founder of the Mughal dynasty",
        "steps": [
          0,
          1,
          2
        ],
        "text": "Born in Fergana, in today’s Uzbekistan, and a soldier from boyhood, he lost two kingdoms before winning Kabul and then Hindustan. His memoir, the Baburnama, written in Chagatai Turkish, is frank about his defeats and his drinking, scornful of much of India and full of its plants and animals. He died at Agra in 1530."
      },
      {
        "id": "ibrahim-lodi",
        "name": "Ibrahim Lodi",
        "native": "इब्राहिम लोदी",
        "life": "died 1526",
        "role": "Last sultan of Delhi",
        "steps": [
          1
        ],
        "text": "The last sultan of Delhi, of the Afghan Lodi dynasty, who came to the throne in 1517. His efforts to curb powerful Afghan nobles turned several against him; Daulat Khan Lodi, governor of Punjab, and his uncle Alam Khan are said to have invited Babur. He died fighting at Panipat with thousands of his men."
      },
      {
        "id": "bairam-khan",
        "name": "Bairam Khan",
        "native": "بیرم خان",
        "lang": "fa",
        "life": "c. 1501–1561",
        "role": "Akbar’s regent",
        "steps": [
          3,
          5
        ],
        "text": "A Turkoman commander who stayed loyal to Humayun through exile and became Akbar’s guardian and regent. He commanded the Mughal army at Panipat in 1556. Akbar dismissed him in 1560 and sent him on pilgrimage to Mecca; on the way he was murdered at Patan in Gujarat. His son, Abdul Rahim Khan-i-Khanan, became a celebrated poet."
      },
      {
        "id": "akbar",
        "name": "Akbar",
        "native": "جلال‌الدین محمد اکبر",
        "lang": "fa",
        "life": "1542–1605",
        "role": "Mughal emperor",
        "steps": [
          3,
          5
        ],
        "text": "Babur’s grandson, crowned at thirteen in the crisis of 1556. After ending Bairam Khan’s regency in 1560 he built the Mughal Empire across most of northern India, married into Rajput ruling houses, abolished the tax on non-Muslims (jizya) and held debates between faiths at Fatehpur Sikri. He reigned for almost fifty years."
      },
      {
        "id": "hemu",
        "name": "Hemu",
        "native": "हेमचंद्र विक्रमादित्य",
        "life": "c. 1501–1556",
        "role": "General of Adil Shah Sur",
        "steps": [
          4,
          5
        ],
        "text": "Hem Chandra, born probably near Rewari to a family of modest means, supplied the Sur armies before becoming Adil Shah Sur’s chief minister and general. In 1556 he took Delhi and ruled it for about a month as Vikramaditya, one of very few Hindu rulers of Delhi in the medieval period. He was beheaded after the battle at Panipat."
      },
      {
        "id": "ahmad-shah-durrani",
        "name": "Ahmad Shah Durrani",
        "native": "احمد شاه دراني",
        "lang": "ps",
        "life": "c. 1722–1772",
        "role": "Founder of the Durrani Empire",
        "steps": [
          6,
          7,
          10,
          11
        ],
        "text": "An Afghan cavalry commander of Nader Shah of Persia who, after Nader’s murder in 1747, was chosen king near Kandahar and founded the Durrani Empire, the start of modern Afghanistan. He invaded India repeatedly, sacked Delhi in 1757 and won at Panipat in 1761. Afghans remember him as Ahmad Shah Baba, father of the nation."
      },
      {
        "id": "sadashivrao-bhau",
        "name": "Sadashivrao Bhau",
        "native": "सदाशिवराव भाऊ",
        "lang": "mr",
        "life": "1730–1761",
        "role": "Maratha commander at Panipat",
        "steps": [
          8,
          9,
          10
        ],
        "text": "Nephew of Peshwa Baji Rao I and cousin of Peshwa Balaji Baji Rao, he ran the Peshwas’ finances and beat the Nizam at Udgir in 1760. He led the great expedition north and was killed at Panipat. His headless body was found after the battle, yet for years men claiming to be the Bhau appeared in the Deccan."
      },
      {
        "id": "ibrahim-khan-gardi",
        "name": "Ibrahim Khan Gardi",
        "native": "इब्राहिम खान गारदी",
        "life": "died 1761",
        "role": "Commander of the Maratha artillery",
        "steps": [
          8,
          10
        ],
        "text": "A soldier who learned European drill and gunnery in the French service under Bussy in the Deccan, then commanded the Peshwa’s trained infantry and guns. His men broke the Rohilla wing at Panipat. Wounded and captured, he was put to death by the Afghans. The name Gardi is usually traced to the French garde, guard."
      }
    ]
  }
}
