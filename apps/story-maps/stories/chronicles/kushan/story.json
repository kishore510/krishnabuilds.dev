  "people": {
    "heading": "Kings and witnesses",
    "items": [
      {
        "id": "zhang-qian",
        "name": "Zhang Qian",
        "native": "张骞",
        "lang": "zh",
        "life": "died about 113 BCE",
        "role": "Han envoy to the west",
        "steps": [
          0
        ],
        "text": "Sent west by the Han emperor Wu to win the Yuezhi as allies against the Xiongnu, Zhang Qian was held captive by the Xiongnu for about ten years. When he reached the Yuezhi, they had settled and refused to fight. His report on the western lands helped open China’s trade with Central Asia."
      },
      {
        "id": "kujula",
        "name": "Kujula Kadphises",
        "life": "1st century CE (dates disputed)",
        "role": "Founder of the Kushan kingdom",
        "steps": [
          1,
          2,
          4
        ],
        "text": "The Kushan chief who, says the Book of the Later Han, united the five Yuezhi chiefdoms and took the Kabul valley and Gandhara. His coins borrow from Greek, Parthian and Roman models, and are written in Greek and Kharoshthi. Kanishka’s Rabatak inscription names him as his great-grandfather."
      },
      {
        "id": "wima",
        "name": "Wima Kadphises",
        "life": "about 100 CE (dates disputed)",
        "role": "Conqueror and first Kushan gold coinage",
        "steps": [
          3,
          4
        ],
        "text": "Son of Wima Takto and father of Kanishka, Wima Kadphises ruled from Bactria into northern India. He issued the first Kushan gold coins, heavy pieces close in weight to Roman gold, and many show Shiva with his bull. A seated royal statue at Mat, near Mathura, is often identified as him."
      },
      {
        "id": "kanishka",
        "name": "Kanishka",
        "native": "कनिष्क",
        "life": "ruled from about 127 CE",
        "role": "The greatest Kushan king",
        "steps": [
          3,
          4,
          5,
          6,
          7
        ],
        "text": "Kanishka ruled from Bactria to the Ganges plain. His coins name Greek, Iranian and Indian gods, and among them is one of the first named images of the Buddha (Boddo). Buddhist tradition remembers him as a second Ashoka, patron of a great stupa and a council. When his reign began is disputed."
      },
      {
        "id": "huvishka",
        "name": "Huvishka",
        "native": "हुविष्क",
        "life": "ruled about 150 to 190 CE",
        "role": "Kanishka’s successor",
        "steps": [
          8,
          10
        ],
        "text": "Huvishka followed Kanishka and his short-lived successor Vasishka. His long reign left more coin types than any other Kushan king, with gods from Greek, Iranian and Indian worship, among them Skanda and the Iranian goddess Nana. His inscriptions are found at Mathura, where many Buddhist and Jain images date from his time."
      },
      {
        "id": "vasudeva",
        "name": "Vasudeva I",
        "native": "वासुदेव",
        "life": "ruled about 190 to 230 CE",
        "role": "The last great Kushan king",
        "steps": [
          10,
          11
        ],
        "text": "Vasudeva bore the name of a Hindu god, and almost all his coins show Shiva. He is usually taken to be the Bodiao who sent an envoy to China in 229 CE. In or soon after his reign, the rising Sasanians took Bactria, and the empire broke into smaller kingdoms."
      }
    ]
  }
