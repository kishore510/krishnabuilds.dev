{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krishnabuilds-story-maps",
  "compatibility_date": "2026-11-08",
  // Static assets only, no Worker script. Unknown paths get dist/404.html
  // (no single-page-application fallback: every story is its own page).
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "story-maps.krishnabuilds.dev", "custom_domain": true }]
}
