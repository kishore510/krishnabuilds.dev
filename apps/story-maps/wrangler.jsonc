{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krishnabuilds-story-maps",
  "compatibility_date": "2026-11-08",
  // A small Worker for the likes API (/api/*); everything else is the static
  // site. Unknown paths get dist/404.html (no single-page-application
  // fallback: every story is its own page).
  "main": "src/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // Every story's counts, one JSON blob per key: "likes" and "reads".
  // The id names the namespace (story-maps-likes); it is not a secret.
  "kv_namespaces": [
    {
      "binding": "STORY_COUNTS",
      "id": "3f9f73ca4a6847d392303575b8b5eaa1"
    }
  ],
  // Basic per-IP limit on every write: likes, taking them back and reads. namespace_id is a
  // free-form number unique within the account (Arcade uses 1001).
  "ratelimits": [
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "routes": [{ "pattern": "story-maps.krishnabuilds.dev", "custom_domain": true }]
}
